{
	"Logging": {
		"LogLevel": {
			"Default": "Warning",
			"Microsoft.AspNetCore": "Warning",
			"Yarp": "Information"
		},
		"Console": {
			"LogLevel": {
				"Default": "Information",
				"Microsoft.AspNetCore": "Information",
				"Microsoft.EntityFrameworkCore.Database.Command": "Warning",
				"Yarp": "Debug"
			},
			"FormatterName": "Systemd",
			"FormatterOptions": {
				"IncludeScopes": true,
				"TimestampFormat": "dd.mm.yyyy HH:mm:ss > ",
				"UseUtcTimestamp": false
			}
		}
	},
	"AllowedHosts": "*",
	"ClientApp": "http://localhost:3000",
	"CacheImageExpirationDays": 1,
	"ReverseProxy": {
		"Routes": {
			"auctionsRead": {
				"ClusterId": "auctions",
				"Match": {
					"Path": "/api/auctions/{**catch-all}",
					"Methods": ["GET"]
				},
				"Transforms": [
					{
						"PathPattern": "/api/auctions/{**catch-all}"
					}
				]
			},
			"auctionsWrite": {
				"ClusterId": "auctions",
				"AuthorizationPolicy": "default",
				"Match": {
					"Path": "/api/auctions/{**catch-all}",
					"Methods": ["POST", "PUT", "DELETE"]
				},
				"Transforms": [
					{
						"PathPattern": "/api/auctions/{**catch-all}"
					}
				]
			},
			"search": {
				"ClusterId": "search",
				"Match": {
					"Path": "/api/search/{**catch-all}",
					"Methods": ["GET", "POST"]
				},
				"Transforms": [
					{
						"PathPattern": "/api/search/{**catch-all}"
					}
				]
			},
			"identity": {
				"ClusterId": "identity",
				"Match": {
					"Path": "/api/identity/{**catch-all}",
					"Methods": ["POST"]
				},
				"Transforms": [
					{
						"PathPattern": "/auth/{**catch-all}"
					}
				]
			},
			"bids": {
				"ClusterId": "bids",
				"Match": {
					"Path": "/api/bids/{**catch-all}",
					"Methods": ["GET"]
				}
			},
			"notifications": {
				"ClusterId": "notifications",
				"CorsPolicy": "customPolicy",
				"Match": {
					"Path": "/api/notifications/{**catch-all}"
				},
				"Transforms": [
					{
						"PathPattern": "notifications/{**catch-all}"
					}
				]
			},
			"finance": {
				"ClusterId": "finance",
				"AuthorizationPolicy": "default",
				"Match": {
					"Path": "/api/finance/{**catch-all}",
					"Methods": ["GET", "POST"]
				}
			},
			"processing": {
				"ClusterId": "processing",
				"AuthorizationPolicy": "default",
				"Match": {
					"Path": "/api/processing/{**catch-all}",
					"Methods": ["GET", "POST"]
				}
			},
			"reports": {
				"ClusterId": "reports",
				"Match": {
					"Path": "/reports/{**catch-all}",
					"Methods": ["GET"]
				}
			},
			"reportsapi": {
				"ClusterId": "reportsapi",
				"Match": {
					"Path": "/api/reports/{**catch-all}",
					"Methods": ["POST"]
				}
			},
			"client": {
				"ClusterId": "client",
				"Match": {
					"Path": "/{**catch-all}",
					"Methods": ["GET"]
				}
			}
		},
		"Clusters": {
			"auctions": {
				"Destinations": {
					"auctionApi": {
						"Address": "http://auction-eventsourcing-clusterip"
					}
				}
			},
			"search": {
				"Destinations": {
					"searchApi": {
						"Address": "http://auction-search-clusterip"
					}
				}
			},
			"identity": {
				"Destinations": {
					"identityApi": {
						"Address": "http://auction-identity-clusterip"
					}
				}
			},
			"bids": {
				"Destinations": {
					"bidApi": {
						"Address": "http://auction-bid-clusterip"
					}
				}
			},
			"notifications": {
				"Destinations": {
					"notifyApi": {
						"Address": "http://auction-notify-clusterip"
					}
				}
			},
			"finance": {
				"Destinations": {
					"financeApi": {
						"Address": "http://auction-finance-clusterip"
					}
				}
			},
			"processing": {
				"Destinations": {
					"processingApi": {
						"Address": "http://auction-processing-clusterip"
					}
				}
			}
		}
	},
	"MetricGroup": "GateWayMetric",
	"Otlp": {
		"Endpoint": "http://otc-ip-service-import:4317"
	},
	"Redis": {
		"Config": "redis-cluster-ip-service:6379, allowAdmin=true"
	},
	"GrpcImage": "http://auction-image-clusterip:7778",
	"Vault": {
		"Address": "http://vault-cluster-ip-service:8200",
		"VAULT_ROLE_ID": "ba25d8c4-c63f-b184-bfdb-60d84cfe1dd3",
		"SecretPathRt": "rabbitmq/",
		"SecretPathApi": "api/",
		"VAULT_SECRET_ID": "47c9c6e9-ceaf-3e46-4d6c-73d00c8cd5f6"
	},
	"CommonAssembly": "/Contracts.dll"
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "WebApi": {
        "Protocols": "Http1",
        "Url": "http://localhost:7016"
      }
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "reports": {
        "ClusterId": "reports",
        "Match": {
          "Path": "/reports/{**catch-all}",
          "Methods": ["GET"]
        }
      },
      "reportsapi": {
        "ClusterId": "reportsapi",
        "Match": {
          "Path": "/api/reports/{**catch-all}",
          "Methods": ["POST"]
        }
      },
      "frontapi": {
        "ClusterId": "frontapi",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "DELETE"]
        }
      },
      "front": {
        "ClusterId": "front",
        "Match": {
          "Path": "/{**catch-all}",
          "Methods": ["GET"]
        }
      }
    },
    "Clusters": {
      "front": {
        "Destinations": {
          "eventSourcingApi": {
            "Address": "http://localhost:3000"
          }
        }
      },
      "frontapi": {
        "Destinations": {
          "searchApi": {
            "Address": "http://localhost:7013"
          }
        }
      },
      "reports": {
        "Destinations": {
          "reports": {
            "Address": "http://localhost:3001"
          }
        }
      },
      "reportsapi": {
        "Destinations": {
          "reportsApi": {
            "Address": "http://localhost:7008"
          }
        }
      }
    }
  }
}

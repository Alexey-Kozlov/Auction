<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>NU1701</NoWarn>    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AuctionUtils" Version="1.0.0" />
    <PackageReference Include="AuctionContracts" Version="1.0.1" />
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.7" />   
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />   
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ResourceMonitoring" Version="10.4.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.15.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.2-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="VaultSharp" Version="1.17.5.1" /> 
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />            
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/report.proto" GrpcServices="Server" />
  </ItemGroup>  

</Project>

CREATE OR REPLACE FUNCTION public.financeplacebid(
	correlationid_par uuid,
	auctionid_par uuid,
	eventdata_par1 text,
	userlogin_par text)
    RETURNS TABLE(id uuid, auctionid uuid, userlogin character varying, value integer, actiondate timestamp without time zone, status smallint) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	i record;
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;
	balance int = 0;
	eventdata_par jsonb;
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS tmp(EventData jsonb);
CREATE TEMP TABLE IF NOT EXISTS finance(id uuid,auctionid uuid,userlogin varchar(256),value int,actiondate timestamp,status smallint);
CREATE TEMP TABLE IF NOT EXISTS eventlog("Version" integer, "CorrelationId" uuid, "CreateAt" timestamp with time zone,
"EventData" jsonb, "Commited" boolean, "Description" text, "SnapShotId" uuid, "EntityType" character varying(50),
"RestoringOrder" smallint, "AuctionId" uuid, "UserLogin" character varying(256), "OperationType" smallint);
delete from tmp;
delete from finance;
delete from eventlog;

eventdata_par = cast(eventdata_par1 as jsonb);
select "EventsLog"."SnapShotId","EventsLog"."CreateAt" from public."EventsLog" 
where not "EventsLog"."SnapShotId" is null order by "EventsLog"."CreateAt" desc into lastSnapShotId,lastSnapShotCreated;

--получаем последнюю запись финансов по данному аукциону, Status = 1 - расход, т.е. деньги на ставку
insert into eventlog("Version", "CorrelationId", "CreateAt","EventData", "Commited", 
	"Description", "SnapShotId", "EntityType","RestoringOrder", "AuctionId", "UserLogin", "OperationType")
    SELECT 
	"EventsLog"."Version", "EventsLog"."CorrelationId", "EventsLog"."CreateAt", "EventsLog"."EventData", 
	"EventsLog"."Commited", "EventsLog"."Description", "EventsLog"."SnapShotId", "EventsLog"."EntityType",
	"EventsLog"."RestoringOrder", "EventsLog"."AuctionId", "EventsLog"."UserLogin", "EventsLog"."OperationType"
	FROM public."EventsLog"
	where  "EventsLog"."EntityType" = 'FinanceItem' and 
	("EventsLog"."SnapShotId" = lastSnapShotId or "EventsLog"."SnapShotId" is null) and
	"EventsLog"."AuctionId" = auctionid_par and
	"EventsLog"."CreateAt" >= lastSnapShotCreated and
	"EventsLog"."EventData" ->> 'Status' = '1'
	order by "EventsLog"."Version" desc limit 1;

if exists(select * from eventlog) then
--есть предыдущий платеж, возвращаем по нему деньги, делаем запись с Status = 0
	insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
	"Description", "SnapShotId", "EntityType","RestoringOrder", "AuctionId", "UserLogin", "OperationType") 
	select "CorrelationId", now(), "EventData" || jsonb_build_object('ActionDate', now()) || '{"Status":"0"}', "Commited", 
	"Description", "SnapShotId", "EntityType","RestoringOrder", "AuctionId", "UserLogin", "OperationType" 
	from eventlog;
end if;

--получаем баланс по текущему пользователю
insert into tmp(EventData)
    SELECT 
	"EventsLog"."EventData"
	FROM public."EventsLog"
	where  "EventsLog"."EntityType" = 'FinanceItem' and 
	("EventsLog"."SnapShotId" = lastSnapShotId or "EventsLog"."SnapShotId" is null) and
	"EventsLog"."UserLogin" = userlogin_par and
	"EventsLog"."CreateAt" >= lastSnapShotCreated;

	for i in 
	select tmp."eventdata" ->> 'Value' as "Value",
	tmp."eventdata" ->> 'Status' as "Status" 
	from tmp where tmp."eventdata" ->> 'Status' != '2'
	loop
		if i."Status" = '0'
		then
			balance = balance + cast(i."Value" as INTEGER);
		else
			balance = balance - cast(i."Value" as INTEGER);
		end if;
	end loop;
	
--проверка - превышает ли ставка баланс пользователя
--если превышает - делаем exception, что откатывает транзакцию, т.е. все ранее сделанные операции
if balance < cast(eventdata_par ->> 'Value' as INTEGER) then 
raise exception 'Превышен лимит, баланс - %, ставка - %', balance, eventdata_par ->> 'Value';
end if;

--уменьшаем баланс на ставку
balance = balance - cast(eventdata_par ->> 'Value' as INTEGER);	

--делаем новую ставку
insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
	"Description", "SnapShotId", "EntityType","RestoringOrder", "AuctionId", "UserLogin", "OperationType") 
values(correlationid_par,now(),eventdata_par,false,'',null,'FinanceItem',0,auctionid_par,userlogin_par,3);

--возвращаем баланс
insert into finance(id,auctionid,userlogin,value,actiondate,status)
values(gen_random_uuid(),auctionid_par,userlogin_par,balance,now(),2);

--возвращаем корректирующую запись - удаление предыдущей ставки (если была)
if exists(select * from eventlog) then
	insert into finance(id,auctionid,userlogin,value,actiondate,status)
	select gen_random_uuid(), auctionid_par, eventlog."EventData" ->> 'UserLogin' , 
	cast(eventlog."EventData" ->> 'Value' as integer), now(), 0 from eventlog;
end if;
	
return query select finance."id", finance."auctionid",finance."userlogin",finance."value",finance."actiondate",finance."status"
	from finance;
END;
$BODY$;
-- FUNCTION: public.index_elk(uuid, text)

-- DROP FUNCTION IF EXISTS public.index_elk(uuid, text);

CREATE OR REPLACE FUNCTION public.index_elk(
	correlationid_par uuid,
	userlogin_par text)
    RETURNS TABLE(eventdata text, crud smallint, entitytype character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;
BEGIN    
--создаем запись в ES лог о команде переиндексации, Command = 7 - IndexELK, CRUD = 0 - Create
insert into public."EventsLog"("CorrelationId", "CreateAt", "EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD")
VALUES(correlationid_par, now(), '{}', false, '', null, userlogin_par, 7, 0);

select "SnapShotId", "CreateAt" from public."EventsLog" 
where not "SnapShotId" is null order by "CreateAt" desc limit 1 
into lastSnapShotId,lastSnapShotCreated;

--получаем все записи аукционов, группируем по AuctionId, крайние версии, кроме удаленных
return query select cast(t1."EventData" as text), t1."CRUD", t1."EntityType"
	FROM public."EventsLog" t1
	JOIN (
		SELECT max("EventsLog"."Version") as "Version" 
		FROM public."EventsLog"
		where "EntityType" = 'AuctionItem' and
		("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and "CreateAt" >= lastSnapShotCreated
		group by "AuctionId") t2 on t1."Version" = t2."Version"
	where t1."CRUD" != 2;
END;

$BODY$;

ALTER FUNCTION public.index_elk(uuid, text)
    OWNER TO admin;

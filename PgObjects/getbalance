-- PROCEDURE: public.getbalance(character varying, integer)

-- DROP PROCEDURE IF EXISTS public.getbalance(character varying, integer);

CREATE OR REPLACE PROCEDURE public.getbalance(
	IN userlogin_par character varying,
	INOUT balance integer)
LANGUAGE 'plpgsql'
AS $BODY$
declare
	i record;
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;	
BEGIN
CREATE TEMP TABLE IF NOT EXISTS tmp(EventData jsonb);
delete from tmp;

select "EventsLog"."SnapShotId","EventsLog"."CreateAt" from public."EventsLog" 
where not "EventsLog"."SnapShotId" is null order by "EventsLog"."CreateAt" desc limit 1 
into lastSnapShotId,lastSnapShotCreated;
--получаем баланс по текущему пользователю
    SELECT 
	sum(case when cast("EventData" ->> 'Status' as int) = 0 
		then cast("EventData" ->> 'Value' as int) else
		-cast("EventData" ->> 'Value' as int) end)
	FROM public."EventsLog"
	where  "EntityType" = 'FinanceItem' and 
	("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and
	"UserLogin" = userlogin_par and
	"CreateAt" >= lastSnapShotCreated
	into balance;

END;
$BODY$;
ALTER PROCEDURE public.getbalance(character varying, integer)
    OWNER TO admin;

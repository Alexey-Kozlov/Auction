-- PROCEDURE: public.reset_snap_shot()

-- DROP PROCEDURE IF EXISTS public.reset_snap_shot();

CREATE OR REPLACE PROCEDURE public.reset_snap_shot(
	)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN    
--удаляем данные из сервисов чтения данных
create extension IF NOT EXISTS postgres_fdw;
CREATE SERVER IF NOT EXISTS bids FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host '192.168.1.12', dbname 'AuctionsBids', port '5432');
CREATE SERVER IF NOT EXISTS finance FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host '192.168.1.12', dbname 'AuctionsFinance', port '5432');
CREATE SERVER IF NOT EXISTS notif FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host '192.168.1.12', dbname 'AuctionsNotifications', port '5432');
CREATE SERVER IF NOT EXISTS searchs FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host '192.168.1.12', dbname 'AuctionsSearch', port '5432');
CREATE SERVER IF NOT EXISTS images FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host '192.168.1.12', dbname 'AuctionsImages', port '5432');
CREATE USER MAPPING IF NOT EXISTS  FOR admin SERVER bids OPTIONS (user 'admin', password 'admin');
CREATE USER MAPPING IF NOT EXISTS  FOR admin SERVER finance OPTIONS (user 'admin', password 'admin');
CREATE USER MAPPING IF NOT EXISTS  FOR admin SERVER notif OPTIONS (user 'admin', password 'admin');
CREATE USER MAPPING IF NOT EXISTS  FOR admin SERVER searchs OPTIONS (user 'admin', password 'admin');
CREATE USER MAPPING IF NOT EXISTS  FOR admin SERVER images OPTIONS (user 'admin', password 'admin');
drop foreign table if exists "BidItems";
drop foreign table if exists "FinanceItems";
drop foreign table if exists "NotifyItems";
drop foreign table if exists "SearchItems";
drop foreign table if exists "ImageItems";
IMPORT FOREIGN SCHEMA public FROM SERVER bids INTO public;
IMPORT FOREIGN SCHEMA public FROM SERVER finance INTO public;
IMPORT FOREIGN SCHEMA public FROM SERVER notif INTO public;
IMPORT FOREIGN SCHEMA public FROM SERVER searchs INTO public;
IMPORT FOREIGN SCHEMA public FROM SERVER images INTO public;

delete from public."BidItems";
delete from public."FinanceItems";
delete from public."NotifyItems";
delete from public."SearchItems";
delete from public."ImageItems";

END;
$BODY$;
ALTER PROCEDURE public.reset_snap_shot()
    OWNER TO admin;

-- FUNCTION: public.auction_update(uuid, uuid, text, text, text)

-- DROP FUNCTION IF EXISTS public.auction_update(uuid, uuid, text, text, text);

CREATE OR REPLACE FUNCTION public.auction_update(
	correlationid_par uuid,
	auctionid_par uuid,
	eventdata_par text,
	userlogin_par text,
	image_par text)
    RETURNS TABLE(eventdata text, crud smallint, entitytype character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	eventdata jsonb;
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;	
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS ret("eventdata" text,  "crud" smallint, "entitytype" varchar(50));
CREATE TEMP TABLE IF NOT EXISTS eventlog("CorrelationId" uuid, "CreateAt" timestamp with time zone,
"EventData" jsonb, "Commited" boolean, "Description" text, "SnapShotId" uuid, "EntityType" varchar(50),
"AuctionId" uuid, "UserLogin" character varying(256), "Command" smallint,"CRUD" smallint);

delete from ret;
delete from eventlog;
eventdata = cast(eventdata_par as jsonb);

--создаем запись в ES лог об обновлении аукциона, Command=2 - 'AuctionUpdate', CRUD=1 - Update
insert into public."EventsLog"("CorrelationId", "CreateAt", "EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD")
values (correlationid_par, now(), eventdata || jsonb_build_object('UpdatedAt', now()), false, 'AuctionItem', auctionid_par, userlogin_par, 2, 1);

--возвращаем запись для обновления аукциона, CRUD=1 - Update
insert into ret("eventdata", "crud", "entitytype")
values(eventdata_par, 1, 'AuctionItem');

--если есть изображение - обновляем изображение
select "SnapShotId", "CreateAt" from public."EventsLog" 
where not "SnapShotId" is null order by "CreateAt" desc limit 1 
into lastSnapShotId,lastSnapShotCreated;

insert into eventlog("EventData")
    SELECT t1."EventData" || jsonb_build_object('Image',image_par) FROM public."EventsLog" t1
		JOIN (
		SELECT max("Version") as "Version" 
		FROM public."EventsLog"
		where "EntityType" = 'ImageItem' and
		"AuctionId" = auctionid_par and
		("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and "CreateAt" >= lastSnapShotCreated
		group by "AuctionId") t2 on t1."Version" = t2."Version"
	where t1."CRUD" != 2;
	
if exists(select * from eventlog) then
	--изображение найдено
	--создаем запись в ES лог об изменении изображения, Command=2 - 'AuctionUpdate', CRUD=1 - Update
	insert into public."EventsLog"("CorrelationId", "CreateAt", "EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD")
	SELECT
	correlationid_par, now(), "EventData", false, 'ImageItem', auctionid_par, userlogin_par, 2, 1
	FROM eventlog;
	--возвращаем запись для удаления аукциона, CRUD=2 - Delete
	insert into ret("eventdata", "crud", "entitytype")
	select "EventData", 1, 'ImageItem' from eventlog limit 1;
end if;

return query select ret.eventdata, ret.crud, ret.entitytype from ret;
END;
$BODY$;

ALTER FUNCTION public.auction_update(uuid, uuid, text, text, text)
    OWNER TO admin;

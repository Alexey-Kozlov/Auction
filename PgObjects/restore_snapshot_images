-- FUNCTION: public.restore_snap_shot_images(uuid, text, text)

-- DROP FUNCTION IF EXISTS public.restore_snap_shot_images(uuid, text, text);

CREATE OR REPLACE FUNCTION public.restore_snap_shot_images(
	correlationid_par uuid,
	eventdata_par text,
	userlogin_par text)
    RETURNS TABLE(eventdata text, crud smallint, entitytype character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	i record;
	eventdata jsonb;
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;
	maxMessageSizeMb int;
	messageSizeCounter bigint;
	counter int;
	nextSnapShotId uuid;	
	nextSnapShotCreated timestamp;		
	restoreDate timestamp;		
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS ret("eventdata" text,  "crud" smallint, "entitytype" varchar(50));
CREATE TEMP TABLE IF NOT EXISTS eventlog("CorrelationId" uuid, "CreateAt" timestamp with time zone,
"EventData" jsonb, "Commited" boolean, "Description" text, "SnapShotId" uuid, "EntityType" varchar(50),
"AuctionId" uuid, "UserLogin" character varying(256), "Command" smallint,"CRUD" smallint);

delete from ret;

messageSizeCounter = 0;
counter = 0;
eventdata = cast(eventdata_par as jsonb);
restoreDate = cast(eventdata ->> 'RestoreDate' as timestamp with time zone);
--получаем ближайший к указанной дате восстановления SnapShotId
select "SnapShotId", "CreateAt" from public."EventsLog" 
where not "SnapShotId" is null and "CreateAt" <= restoreDate
order by "CreateAt" desc limit 1 
into lastSnapShotId,lastSnapShotCreated;
--получаем следующий SnapShot (если есть), переменная nextSnapShotCreated
select "CreateAt" from public."EventsLog" 
where not "SnapShotId" is null and "CreateAt" > lastSnapShotCreated
order by "CreateAt" asc limit 1 
into nextSnapShotCreated;
--если nextSnapShotCreated = null - больше SnapShot-ов нет и можно не ограничивать дату восстановления
--если nextSnapShotCreated != null - есть следующий SnapShot и нужно ограничить дату восстановления его началом
if not nextSnapShotCreated is null and restoreDate > nextSnapShotCreated then
	restoreDate = nextSnapShotCreated;
end if;

maxMessageSizeMb = cast(eventdata ->> 'MaxMessageSizeMb' as int);
--если передали параметр MaxMessageSizeMb = 0 - означает, что нужно вернуть общее количество восстанавливаемых записей
if maxMessageSizeMb = 0 then
	insert into ret("eventdata", "crud", "entitytype")
	select '{}', 0, cast(count(*) as varchar(256))
	from public."EventsLog" t1 
	join
		(SELECT max("Version") as "Version" 
			FROM public."EventsLog"
			where "EntityType" = 'ImageItem' and
			("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and 
			("CreateAt" between lastSnapShotCreated and restoreDate)			
			group by "AuctionId") t2 
		on t1."Version" = t2."Version"
	where t1."CRUD" != 2;
	
else

--возвращаем записи для сервиса ImageService пачками, размером не более переданного
--получаем записи ImageItem для восстановления в сервисе ImageService
	for i in
	select t1."EventData"
	from public."EventsLog" t1 
	join
		(SELECT max("Version") as "Version" 
			FROM public."EventsLog"
			where "EntityType" = 'ImageItem' and
			("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and 
			("CreateAt" between lastSnapShotCreated and restoreDate)
			group by "AuctionId") t2 
		on t1."Version" = t2."Version"
	where t1."CRUD" != 2
	offset cast(eventdata ->> 'StartNumber' as int)
	loop
	--счетчик общего размера возвращаемых изображений
		messageSizeCounter = messageSizeCounter + length(i."EventData" ->> 'Image');
	--выход, если общий размер превышает заданный (maxMessageSizeMb) или это хотя бы одна запись
		exit when messageSizeCounter >= (maxMessageSizeMb * 1000000) and counter > 0;
		insert into ret("eventdata", "crud", "entitytype") values(i."EventData",0,'ImageItem');
		counter = counter + 1;
	end loop;
end if;
--здесь заглушка - возвращаем хотя бы одну пустую запись, это на случай, если вдруг не будет возвращаемых записей, 
--в этом случае (если не будет возвращаемых строк) будет ошибка.
if not exists (select * from ret) then
	insert into ret("eventdata", "crud", "entitytype") values('{}',0,'ImageItem');
end if;

return query select ret.eventdata, ret.crud, ret.entitytype from ret;
END;
$BODY$;

ALTER FUNCTION public.restore_snap_shot_images(uuid, text, text)
    OWNER TO admin;

-- FUNCTION: public.auction_delete(uuid, uuid, text)

-- DROP FUNCTION IF EXISTS public.auction_delete(uuid, uuid, text);

CREATE OR REPLACE FUNCTION public.auction_delete(
	correlationid_par uuid,
	auctionid_par uuid,
	userlogin_par text)
    RETURNS TABLE(eventdata text, crud smallint, entitytype character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	i record;
	balance int = 0;
	lastSnapShotId uuid;
	lastSnapShotCreated timestamp;
	userlogin_temp varchar(256);
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS ret("eventdata" text,  "crud" smallint, "entitytype" varchar(50));
CREATE TEMP TABLE IF NOT EXISTS eventlog("CorrelationId" uuid, "CreateAt" timestamp with time zone,
"EventData" jsonb, "Commited" boolean, "Description" text, "SnapShotId" uuid, "EntityType" varchar(50),
"AuctionId" uuid, "UserLogin" character varying(256), "Command" smallint,"CRUD" smallint);

delete from ret;
delete from eventlog;

select "SnapShotId", "CreateAt" from public."EventsLog" 
where not "SnapShotId" is null order by "CreateAt" desc limit 1 
into lastSnapShotId,lastSnapShotCreated;

--получаем запись аукциона, которую нужно удалить
insert into eventlog("EventData")
    SELECT t1."EventData" FROM public."EventsLog" t1
		JOIN (
		SELECT max("Version") as "Version" 
		FROM public."EventsLog"
		where "EntityType" = 'AuctionItem' and
		"AuctionId" = auctionid_par and
		("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and "CreateAt" >= lastSnapShotCreated
		group by "AuctionId") t2 on t1."Version" = t2."Version"
	where t1."CRUD" != 2;

if not exists(select * from eventlog) then
	raise exception 'Не найден аукцион - %', auctionid_par;
end if;

--создаем запись в ES лог об удалении аукциона, Command=0 - 'AuctionDelete', CRUD=2 - Delete
insert into public."EventsLog"("CorrelationId", "CreateAt", "EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD")
SELECT 
	correlationid_par, now(), "EventData", false, 'AuctionItem', auctionid_par, userlogin_par, 0, 2
	FROM eventlog;
--возвращаем запись для удаления аукциона, CRUD=2 - Delete
insert into ret("eventdata", "crud", "entitytype")
select "EventData", 2, 'AuctionItem' from eventlog limit 1;

delete from eventlog;

--получаем последнюю запись по ID аукциона и типу FinanceItem. Status=1 - расход денег, т.е. была сделана ставка
--если такая есть - нужно ее отменить, т.е. возвратить деньги по этой ставке пользователю, кто сделал ставку
insert into eventlog("EventData")
    SELECT t1."EventData" FROM public."EventsLog" t1
	JOIN (
		SELECT max("Version") as "Version" 
		FROM public."EventsLog"
		where "EntityType" = 'FinanceItem' and
		"AuctionId" = auctionid_par and
		("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and "CreateAt" >= lastSnapShotCreated
		group by "AuctionId") t2 on t1."Version" = t2."Version"		
	where  
	cast(t1."EventData" ->> 'Status' as int) = 1;

if exists(select * from eventlog) then
--такая запись есть, были ставки
--делаем запись в ES лог по возврату денег, делаем запись с Status = 0 - приход денег, 
--Command=0 - 'AuctionDelete', CRUD=2 - Delete
	insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD") 
	select correlationid_par, now(), "EventData" || jsonb_build_object('ActionDate', now()) || '{"Status":0}', false, 
	'FinanceItem', auctionid_par, userlogin_par, 0, 2
	from eventlog;

--возвращаем запись для возврата денег по ставке, CRUD=2 - Delete
	insert into ret("eventdata", "crud", "entitytype")
	select "EventData", 2, 'FinanceItem'
	from eventlog;

--получаем баланс по пользователю, которому возвращаем платеж
	select "EventData" ->> 'UserLogin' from eventlog into userlogin_temp;
	call getbalance(userlogin_temp,balance);
--возвращаем запись для обновления баланса, CRUD=1 - Update
	insert into ret("eventdata", "crud", "entitytype")
	select "EventData", 1, 'FinanceItem'
	from eventlog;

--делаем запись в ES лог по отмене всех ставок по данному аукциону
	delete from eventlog;
--получаем все ставки по этому аукциону - нужно их всех послать для удаления из БД AuctionsBids
--отбираем записи по AuctionId с типом 'BidItem' и CRUD=0 - добавление
	for i in
    SELECT "EventData" FROM public."EventsLog"
	where  "EntityType" = 'BidItem' and 
	("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and
	"AuctionId" = auctionid_par and
	"CreateAt" >= lastSnapShotCreated and
	"CRUD" = 0
	loop
	--возвращаем записи ставок с типом записи CRUD=2 - Delete, для удаления в BiddingService
		insert into ret("eventdata", "crud", "entitytype")
		values(i."EventData", 2, 'BidItem');	

	--делаем записи в ES лог по удалению ставок, делаем запись с Command=0 - 'AuctionDelete', CRUD=2 - Delete
		insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
		"EntityType", "AuctionId", "UserLogin", "Command", "CRUD") 
		select correlationid_par, now(), i."EventData" || jsonb_build_object('ActionDate', now()), false, 
		'BidItem', auctionid_par, userlogin_par, 0, 2;

	end loop;			
end if;

--удаляем уведомления (если есть) 
--отбираем записи по AuctionId с типом 'NotifyItem' и CRUD=0 - добавление
for i in
SELECT "EventData" FROM public."EventsLog"
	where  "EntityType" = 'NotifyItem' and 
	("SnapShotId" = lastSnapShotId or "SnapShotId" is null) and
	"AuctionId" = auctionid_par and
	"CreateAt" >= lastSnapShotCreated and
	"CRUD" = 0
loop
	--возвращаем записи уведомлений с типом записи CRUD=2 - Delete, для удаления в NotificationService
		insert into ret("eventdata", "crud", "entitytype")
		values(i."EventData", 2, 'NotifyItem');	

	--делаем записи в ES лог по удалению ставок, делаем запись с Command=0 - 'AuctionDelete', CRUD=2 - Delete
		insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
		"EntityType", "AuctionId", "UserLogin", "Command", "CRUD") 
		select correlationid_par, now(), i."EventData" || jsonb_build_object('ActionDate', now()), false, 
		'NotifyItem', auctionid_par, userlogin_par, 0, 2;
end loop;

return query select ret.eventdata, ret.crud, ret.entitytype from ret;
END;
$BODY$;

ALTER FUNCTION public.auction_delete(uuid, uuid, text)
    OWNER TO admin;

-- FUNCTION: public.finance_create(uuid, text, text)

-- DROP FUNCTION IF EXISTS public.finance_create(uuid, text, text);

CREATE OR REPLACE FUNCTION public.finance_create(
	correlationid_par uuid,
	eventdata_par text,
	userlogin_par text)
    RETURNS TABLE(eventdata text, crud smallint, entitytype character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	eventdata jsonb;
	balance int = 0;
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS ret("eventdata" text,  "crud" smallint, "entitytype" varchar(50));

delete from ret;
eventdata = cast(eventdata_par as jsonb);

--создаем запись в ES лог о создании поступления денег, Command=3 - 'FinanceCreate', CRUD=0 - Create
insert into public."EventsLog"("CorrelationId", "CreateAt", "EventData", "Commited", 
	"EntityType", "AuctionId", "UserLogin", "Command", "CRUD")
values (correlationid_par, now(), eventdata, false, 'FinanceItem', null, userlogin_par, 3, 0);

--возвращаем запись для создания записи о поступлении денег, CRUD=0 - Create
insert into ret("eventdata", "crud", "entitytype")
values(eventdata, 0, 'FinanceItem');

--получаем баланс по пользователю, которому делаем поступление денег
call getbalance(userlogin_par,balance);
--возвращаем запись для обновления баланса, CRUD=1 - Update, Status=2 - Balance
eventdata = eventdata || 
	jsonb_build_object('ActionDate', now(), 'Value', balance, 'Status', 2, 'FinanceId', gen_random_uuid());
insert into ret("eventdata", "crud", "entitytype")
values(eventdata, 1, 'FinanceItem');

return query select ret.eventdata, ret.crud, ret.entitytype from ret;
END;
$BODY$;

ALTER FUNCTION public.finance_create(uuid, text, text)
    OWNER TO admin;

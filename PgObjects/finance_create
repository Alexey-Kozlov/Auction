CREATE OR REPLACE FUNCTION public.finance_create(
	correlationid_par uuid,
	auctionid_par uuid,
	eventdata_par1 text,
	userlogin_par text)
    RETURNS TABLE(id uuid, auctionid uuid, userlogin character varying, value integer, actiondate timestamp without time zone, status smallint) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
declare
	i record;
	balance int = 0;
	eventdata_par jsonb;
BEGIN    
CREATE TEMP TABLE IF NOT EXISTS tmp(EventData jsonb);
CREATE TEMP TABLE IF NOT EXISTS finance(id uuid,auctionid uuid,userlogin varchar(256),value int,actiondate timestamp,status smallint);
CREATE TEMP TABLE IF NOT EXISTS eventlog("Version" integer, "CorrelationId" uuid, "CreateAt" timestamp with time zone,
"EventData" jsonb, "Commited" boolean, "Description" text, "SnapShotId" uuid, "EntityType" character varying(50),
"RestoringOrder" smallint, "AuctionId" uuid, "UserLogin" character varying(256), "OperationType" smallint);
delete from tmp;
delete from finance;
delete from eventlog;
--получаем jsonb из поступившего сообщения
eventdata_par = cast(eventdata_par1 as jsonb);

--получаем баланс по текущему пользователю
call getbalance(userlogin_par,balance);

--добавляем приход в баланс
balance = balance + cast(eventdata_par ->> 'Value' as int);	

--делаем новый приход
insert into public."EventsLog"("CorrelationId", "CreateAt","EventData", "Commited", 
	"Description", "SnapShotId", "EntityType","RestoringOrder", "AuctionId", "UserLogin", "OperationType") 
values(correlationid_par,now(),eventdata_par,false,'',null,'FinanceItem',0,auctionid_par,userlogin_par,2);

--возвращаем баланс
insert into finance(id,auctionid,userlogin,value,actiondate,status)
values(gen_random_uuid(),auctionid_par,userlogin_par,balance,now(),2);

return query select finance."id", finance."auctionid",finance."userlogin",finance."value",finance."actiondate",finance."status"
	from finance;
END;
$BODY$;